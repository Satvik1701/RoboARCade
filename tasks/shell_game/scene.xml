<mujoco model="base">
  <compiler angle="radian" />
  <option impratio="20" density="1.2" viscosity="2e-05" cone="elliptic" />
  <size njmax="5000" nconmax="5000" />
  <visual>
    <!-- shadowclip pulls the shadow frustum onto the table: at the default the room
         spreads the map so thin that the walls speckle and the cup rims band. -->
    <map znear="0.001" shadowclip="0.03" />
    <quality shadowsize="4096" />
    <!-- MuJoCo's camera-mounted lamp is the single biggest flattener; turned down so
         the key light does the modelling, but kept specular so props stay glossy from
         every camera, not just the one the key happens to favour. -->
    <headlight ambient="0.26 0.26 0.28" diffuse="0.16 0.16 0.17" specular="0.35 0.35 0.35" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.78 0.80 0.84" rgb2="0.28 0.31 0.36" width="256" height="1536" />
    <!-- baked by bake_textures(); 2d, not cube: a cube texture is sampled by
         direction, which smears a surface into a sunburst from the geom centre. -->
    <texture type="2d" name="textable" file="assets/table.png" />
    <texture type="2d" name="texfloor" file="assets/floor.png" />
    <texture type="2d" name="texwall" file="assets/wall.png" />
    <texture type="2d" name="texhousing" file="assets/housing.png" />
    <mesh name="cupmesh" file="assets/cup.obj" />
    <mesh name="bzlmesh" file="assets/bezel.obj" />
    <!-- named for the renderer, not just for us: pbr.py reads "tabletop" as timber.
         Left unnamed it fell through to glossy plastic and the table mirrored the arm. -->
    <material name="tabletop_wood" texture="textable" texrepeat="1 1" specular="0.10" shininess="0.12" />
    <material name="floor_mat" texture="texfloor" texuniform="true" texrepeat="6 6" specular="0.04" shininess="0.05" />
    <material name="wall_mat" texture="texwall" texrepeat="2 2" specular="0.02" shininess="0.02" />
    <!-- ONE shell material shared by all seven cups, so they stay identical by
         construction rather than by everyone remembering to keep them so. -->
    <material name="shell_mat" specular="0.8" shininess="0.45" />
    <material name="satin_mat" specular="0.3" shininess="0.35" />
    <material name="housing_mat" texture="texhousing" texrepeat="3 3" specular="0.35" shininess="0.3" />
    <material name="collar_mat" specular="0.6" shininess="0.65" />
    <material name="cap_mat" specular="1" shininess="0.4" />
  </asset>

